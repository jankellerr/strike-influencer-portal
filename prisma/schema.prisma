// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Influencer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  status       InfluencerStatus @default(ACTIVE)

  phone               String?
  cpf                 String?
  shirtSize           String?
  addressStreet       String?
  addressNumber       String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coupon             Coupon?
  utmLinks           UtmLink[]
  loginTokens        LoginToken[]
  commissionPayments CommissionPayment[]
  shipments          Shipment[]
}

enum InfluencerStatus {
  ACTIVE
  INACTIVE
}

model LoginToken {
  id           String     @id @default(cuid())
  token        String     @unique
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([influencerId])
}

model Coupon {
  id             String     @id @default(cuid())
  yampiPromoId   String     @unique
  code           String     @unique
  discountType   String
  discountValue  Decimal
  active         Boolean    @default(true)
  influencer     Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId   String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders Order[]
}

model Order {
  id             String   @id @default(cuid())
  yampiOrderId   String   @unique
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  couponId       String?
  status         String
  valueTotal     Decimal
  valueDiscount  Decimal  @default(0)
  valueProducts  Decimal
  orderedAt      DateTime
  rawItems       Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([couponId])
  @@index([orderedAt])
}

model Product {
  id             String   @id @default(cuid())
  shopifyGid     String   @unique
  handle         String   @unique
  title          String
  imageUrl       String?
  onlineStoreUrl String
  /// Per-item cost synced from Shopify's inventory item unit cost (requires
  /// the read_inventory scope -- see README). Null until that's set up, or if
  /// the merchant never entered a cost for the item in Shopify. Used only as
  /// a prefill default on the shipment form -- always manually overridable.
  costPerItem    Decimal?
  syncedAt       DateTime @default(now())

  utmLinks      UtmLink[]
  shipmentItems ShipmentItem[]
}

model UtmLink {
  id           String     @id @default(cuid())
  slug         String     @unique
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  utmSource    String
  utmMedium    String
  utmCampaign  String
  createdAt    DateTime   @default(now())

  clickEvents ClickEvent[]

  @@index([influencerId])
}

model ClickEvent {
  id        String   @id @default(cuid())
  utmLink   UtmLink  @relation(fields: [utmLinkId], references: [id], onDelete: Cascade)
  utmLinkId String
  clickedAt DateTime @default(now())
  referrer  String?
  userAgent String?

  @@index([utmLinkId])
  @@index([clickedAt])
}

model TutorialVideo {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

/// Whether an influencer's commission for a given calendar month ("YYYY-MM",
/// Brazil timezone) has been paid out. Admin-only to set; influencers can
/// only read their own.
model CommissionPayment {
  id           String     @id @default(cuid())
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId String
  month        String
  paid         Boolean    @default(false)
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([influencerId, month])
  @@index([month])
}

/// Simple internal grouping for shipments (e.g. "Summer Drop", "Holiday Kit")
/// -- defined ad hoc in the admin panel, not synced from Shopify.
model Collection {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())

  shipments Shipment[]
}

/// A batch of product sent to an influencer. Total cost (shippingFee + the
/// sum of its items' quantity * unitCost) is both "shipment value" for the
/// shipments dashboard and the investment side of that influencer's ROI.
model Shipment {
  id           String      @id @default(cuid())
  influencer   Influencer  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  influencerId String
  collection   Collection? @relation(fields: [collectionId], references: [id])
  collectionId String?
  shippedAt    DateTime
  shippingFee  Decimal     @default(0)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items ShipmentItem[]

  @@index([influencerId])
  @@index([shippedAt])
  @@index([collectionId])
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  /// Snapshot of the per-item cost at ship time (from Product.costPerItem or
  /// manually entered) -- doesn't move if Shopify's cost changes later.
  unitCost   Decimal
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}
